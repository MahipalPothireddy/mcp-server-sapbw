# Example environment file for mcp-server-sapbw.
#
# Copy to `.env` (git-ignored) and fill in real values locally, or export these in your
# shell / inject them via your MCP client config. NEVER commit real credentials.
#
# These names are referenced by ${VAR} interpolation in profiles.yaml.

# Path to your (git-ignored) profiles file.
BW_PROFILES_PATH=./profiles.yaml

# FastMCP log level (ERROR keeps stdio clean for MCP clients).
FASTMCP_LOG_LEVEL=ERROR

# --- dev system ---
BW_DEV_HOST=your-dev-host.example.invalid
BW_DEV_USER=your_readonly_user
BW_DEV_PASSWORD=changeme

# --- qa system ---
BW_QA_HOST=your-qa-host.example.invalid
BW_QA_USER=your_readonly_user
BW_QA_PASSWORD=changeme

# --- prd system ---
BW_PRD_HOST=your-prd-host.example.invalid
BW_PRD_USER=your_readonly_user
BW_PRD_PASSWORD=changeme
