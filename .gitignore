# secrets and customer metadata - never commit
.env
profiles.yaml
output/
extracts/
cache/
*.sqlite
.kiro/settings/mcp.json
__pycache__/
.venv/
# Python build / tooling
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
